# Optional. When unset, the app reads validated seed JSON from data/seed and /admin is read-only.
DATABASE_URL="postgresql://optima:optima@localhost:5432/optima"
# Required to use /admin (HTTP Basic auth, any username).
ADMIN_PASSWORD="change-me"
# Protects the cron ingestion route (Vercel sends this as a Bearer token).
CRON_SECRET="change-me"
